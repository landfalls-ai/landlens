{
  "name": "@landlens/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Landlens desktop app (Electron).",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --dir test --exclude '**/*.e2e.test.ts'",
    "test:integration": "echo none",
    "test:e2e": "electron-vite build && LANDLENS_INTEGRATION=${LANDLENS_INTEGRATION:-orbstack} vitest run --dir test --no-file-parallelism e2e",
    "check:fuses": "node scripts/check-fuses.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.107.0",
    "@agentclientprotocol/sdk": "2.7.0",
    "@landlens/acp-host": "workspace:*",
    "@landlens/connections": "workspace:*",
    "@landlens/contracts": "workspace:*",
    "@landlens/kube": "workspace:*",
    "@landlens/kube-mcp": "workspace:*",
    "@landlens/mcp-gateway": "workspace:*",
    "@landlens/metrics": "workspace:*",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.73.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
